# --- client data: never in the repo ---
*.xlsx
*.xlsm
*.xlsb
*.xls
/*_result.*
excel-upload-preparation/runs/
excel-upload-preparation/**/*.changelog.json

# --- secrets / local state ---
# a shared copy's end date (tools/package/build.py writes it into the package only): one next to
# VERSION in the source would stop every developer server (docs/SHARING.md)
excel-upload-preparation/EXPIRY
secret.key
config.enc
.env
.env.*
mind_session.json
*.pem
*.pfx

# --- working copies and scratch ---
New Text Document*.txt
excel-upload-preparation-*/
New/
*.zip
excel-upload-preparation/PACKAGE_INVENTORY.json

# --- python ---
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# --- node (the built dist/ IS committed so a clone runs without Node) ---
FigmaOutput/node_modules/
FigmaOutput/.vite/

# --- logs ---
*.log

# Angular front end (MindReadyUI): the build cache
MindReadyUI/.angular/
