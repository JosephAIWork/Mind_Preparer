{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mind Ready server (http://localhost:8600)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.web.server",
      "cwd": "${workspaceFolder}/excel-upload-preparation",
      "python": "${workspaceFolder}/excel-upload-preparation/.venv/Scripts/python.exe",
      "env": { "MIND_READY_PORT": "8600", "PYTHONIOENCODING": "utf-8" },
      "console": "integratedTerminal",
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
